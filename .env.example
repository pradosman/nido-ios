# Public template only. Set actual values in Dokploy protected variables.
# Never commit a completed .env file or the Apple .p8 private key.
NIDO_POSTGRES_PASSWORD=
NIDO_AUTH_BUCKET_SECRET=
# Public publisher and support contact used by the privacy and support pages.
# Compose also provides these public defaults when no override is set.
NIDO_PRIVACY_CONTROLLER=David Prados Mancilla
NIDO_SUPPORT_EMAIL=pradosman@gmail.com
# Native App ID already used for identity validation and Apple client_id.
NIDO_APPLE_AUDIENCE=
NIDO_APPLE_TEAM_ID=
NIDO_APPLE_KEY_ID=
# Paste the complete multiline PKCS#8 value in the protected-variable editor.
NIDO_APPLE_PRIVATE_KEY=
